{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "WindowsTool (Development)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/WindowsTool.App/bin/Debug/net10.0/WindowsTool.dll",
      "cwd": "${workspaceFolder}/src/WindowsTool.App",
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "WindowsTool__Port": "5179"
      },
      "console": "integratedTerminal",
      "stopAtEntry": false
    }
  ]
}
