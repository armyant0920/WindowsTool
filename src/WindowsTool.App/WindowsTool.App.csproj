<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <AssemblyName>WindowsTool</AssemblyName>
    <RootNamespace>WindowsTool.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- 為 trimming 做準備：設定繫結改用 source generator -->
    <EnableConfigurationBindingGenerator>true</EnableConfigurationBindingGenerator>

    <!-- 前端檔案以 Embedded Resource 打包進 exe，不另外輸出 wwwroot -->
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <StaticWebAssetsEnabled>false</StaticWebAssetsEnabled>

    <!-- 單一 exe 發佈：不產生 IIS 用的 web.config，pdb 嵌入 exe -->
    <IsWebConfigTransformDisabled>true</IsWebConfigTransformDisabled>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**\*" />
    <Content Update="wwwroot\**\*" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WindowsTool.Core\WindowsTool.Core.csproj" />
    <ProjectReference Include="..\WindowsTool.AI\WindowsTool.AI.csproj" />
  </ItemGroup>

</Project>
